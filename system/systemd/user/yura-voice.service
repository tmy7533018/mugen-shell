[Unit]
Description=Yura voice input daemon (push-to-talk -> STT -> chat -> TTS)
# Needs the compositor for qs IPC and PipeWire for the mic. TTS engines
# are enabled independently — run whichever ones your voices use.
After=graphical-session.target voicevox-engine.service aivisspeech-engine.service mugen-ai.service
PartOf=graphical-session.target

[Service]
WorkingDirectory=%h/mugen-shell/voice
Environment=YURA_SILERO_VAD=%h/.local/share/mugen-shell/silero_vad.onnx
# Uncomment if you run AivisSpeech: the daemon then starts it on demand and
# stops it when idle. Left set without the engine installed, every voice-picker
# open waits out the readiness window for a unit that will never come up.
#Environment=YURA_TTS_SERVICE=aivisspeech-engine.service
ExecStart=%h/mugen-shell/voice/.venv/bin/python %h/mugen-shell/voice/yurad.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
