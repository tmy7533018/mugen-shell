[Unit]
Description=Yura speech daemon (read-aloud TTS)
After=graphical-session.target
After=aivisspeech-engine.service
After=mugen-ai.service
PartOf=graphical-session.target

[Service]
WorkingDirectory=/usr/share/mugen-voice
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# A voice dropped in the writable dir shadows a packaged one of the same name.
Environment=YURA_TTS_MODELS=%S/mugen-shell/tts:/usr/share/mugen-voice/tts
Environment=YURA_TTS=aivis:
Environment=YURA_TTS_SERVICE=aivisspeech-engine.service
ExecStart=/usr/bin/python /usr/share/mugen-voice/yurad.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
