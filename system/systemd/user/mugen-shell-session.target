[Unit]
# graphical-session.target sets RefuseManualStart, so Hyprland (which is not a
# session manager) cannot start it directly. It starts this target instead,
# which binds to it and pulls it up — without this, everything hanging off
# graphical-session.target stays down.
Description=mugen-shell graphical session
BindsTo=graphical-session.target
Before=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target
