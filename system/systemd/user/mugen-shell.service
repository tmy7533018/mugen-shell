[Unit]
Description=mugen-shell bar
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/quickshell -c mugen-shell
# A layer shell never becomes the focus window, so Qt reaches fcitx over DBus instead.
Environment=QT_IM_MODULE=fcitx
Environment=QT_QPA_PLATFORMTHEME=xdgdesktopportal
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
