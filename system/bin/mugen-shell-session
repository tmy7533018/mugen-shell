#!/usr/bin/env bash
# Hyprland's exec-once lines call scripts that ~/.config must already carry, so sync first.
set -euo pipefail

mugen-shell-sync || echo "mugen-shell: config sync failed, starting anyway" >&2

# Stamped per unit, so a deliberate `systemctl --user disable` survives the next login.
stamps="${XDG_STATE_HOME:-$HOME/.local/state}/mugen-shell/enabled"
mkdir -p "$stamps"
enable_once() {
  local unit=$1; shift
  if [[ -f "/usr/lib/systemd/user/$unit" && ! -e "$stamps/$unit" ]]; then
    systemctl --user enable "$@" "$unit" > /dev/null 2>&1 || true
    touch "$stamps/$unit"
  fi
}
# The session units wait for Hyprland to raise the session target: started here, the bar has no display yet.
enable_once mugen-shell.service
# default.target is already up, so nothing else will start these on the first login.
enable_once mugen-ai.service --now
enable_once mugen-event-notifier.timer --now

# XWayland clients still reach fcitx over XIM; native ones use the Wayland text-input frontend.
if command -v fcitx5 > /dev/null; then
  export XMODIFIERS="${XMODIFIERS:-@im=fcitx}"
fi

# start-hyprland sets up the session env and the crash-restart watchdog that bare Hyprland skips.
exec start-hyprland "$@"
