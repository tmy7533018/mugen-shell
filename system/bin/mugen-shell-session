#!/usr/bin/env bash
# Hyprland's exec-once lines call scripts that ~/.config must already carry, so sync first.
set -euo pipefail

mugen-shell-sync || echo "mugen-shell: config sync failed, starting anyway" >&2

# The user manager never reads the login profile, and default.target already started mugen-ai without these.
manager_base_dirs() {
  local env pair
  env=$(systemctl --user show-environment 2> /dev/null || true)
  for pair in XDG_CONFIG_HOME:.config XDG_CACHE_HOME:.cache XDG_STATE_HOME:.local/state XDG_DATA_HOME:.local/share; do
    grep -m1 "^${pair%%:*}=" <<< "$env" || echo "${pair%%:*}=$HOME/${pair#*:}"
  done
}
base_dirs_before=$(manager_base_dirs)
systemctl --user import-environment XDG_CONFIG_HOME XDG_CACHE_HOME XDG_STATE_HOME XDG_DATA_HOME 2> /dev/null || true
[[ "$(manager_base_dirs)" == "$base_dirs_before" ]] || systemctl --user try-restart mugen-ai.service || true

# Stamped per unit, so a deliberate `systemctl --user disable` survives the next login.
stamps="${XDG_STATE_HOME:-$HOME/.local/state}/mugen-shell/enabled"
mkdir -p "$stamps"
enable_once() {
  local unit=$1; shift
  if [[ -f "/usr/lib/systemd/user/$unit" && ! -e "$stamps/$unit" ]]; then
    systemctl --user enable "$@" "$unit" > /dev/null 2>&1 || true
    touch "$stamps/$unit"
  fi
}
# The session units wait for Hyprland to raise the session target: started here, the bar has no display yet.
enable_once mugen-shell.service
# default.target is already up, so nothing else will start these on the first login.
enable_once mugen-ai.service --now
enable_once mugen-event-notifier.timer --now

# XWayland clients still reach fcitx over XIM; native ones use the Wayland text-input frontend.
if command -v fcitx5 > /dev/null; then
  export XMODIFIERS="${XMODIFIERS:-@im=fcitx}"
fi

# start-hyprland sets up the session env and the crash-restart watchdog that bare Hyprland skips.
status=0
start-hyprland "$@" || status=$?

# Nothing else ends the session units, and the bar's restart loop would reach whichever compositor starts next.
systemctl --user stop graphical-session.target || true
systemctl --user unset-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP HYPRLAND_INSTANCE_SIGNATURE || true
exit "$status"
