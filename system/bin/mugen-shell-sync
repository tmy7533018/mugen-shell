#!/usr/bin/env bash
# Places the shipped configs into ~/.config. The session wrapper runs this on
# Arch and home-manager's activation runs it on Nix, so both share one copy.
set -euo pipefail

SHARE="${MUGEN_SHELL_SHARE:-/usr/share/mugen-shell}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}"

RUN=()
if [[ "${1:-}" == "--dry-run" ]]; then
  RUN=(echo "[dry-run]")
fi

install_file() {
  local src="$1" dst="$2"
  if [[ -e "$dst" ]]; then
    return 0
  fi
  "${RUN[@]}" mkdir -p "$(dirname "$dst")"
  "${RUN[@]}" install -m 644 "$src" "$dst"
}

# Per file, not per directory: matugen generates into these, and a directory guard would seed nothing ever after.
install_dir() {
  local src="$1" dst="$2" f
  while IFS= read -r -d "" f; do
    install_file "$f" "$dst/${f#"$src"/}"
  done < <(find "$src" -type f -print0)
}

# A tree mugen never synced into holds the user's own configs, so the first overwrite keeps a copy.
shipped_header='-- Hyprland Lua config (mugen-shell)'
first_sync=1
[[ "$(head -n 1 "$CONFIG/hypr/hyprland.lua" 2> /dev/null)" == "$shipped_header"* ]] && first_sync=0
[[ -L "$CONFIG/hypr/hyprland.lua" && -e "$CONFIG/hypr/configs/mugen-shell.lua" ]] && first_sync=0

# Hyprland skips hyprland.conf whenever a hyprland.lua sits beside it.
if (( first_sync && ! ${#RUN[@]} )) && [[ ! -L "$CONFIG/hypr" && -f "$CONFIG/hypr/hyprland.conf" && ! -e "$CONFIG/hypr/hyprland.lua" ]]; then
  echo "mugen-shell: Hyprland now reads the shipped hyprland.lua instead of $CONFIG/hypr/hyprland.conf; move what you need into configs/user-overrides.lua" >&2
fi

same_content() { [[ "$(cksum < "$1")" == "$(cksum < "$2")" ]]; }

# Trailing names are seeded once: the machine or the user owns them afterwards.
install_product_tree() {
  local src="$1" dst="$2"; shift 2
  local f rel mode skip dstReal
  # A linked tree belongs to a checkout or dotfiles repo, where a refresh would revert tracked files.
  if [[ -L "$dst" ]]; then
    echo "mugen-shell: $dst is a symlink, skipping product refresh" >&2
    return 0
  fi
  dstReal=$(realpath -m "$dst")
  while IFS= read -r -d "" f; do
    rel="${f#"$src"/}"
    for skip in "$@"; do
      if [[ "$rel" == "$skip" ]]; then
        install_file "$f" "$dst/$rel"
        continue 2
      fi
    done
    # Writing through a link would rewrite the checkout or dotfiles repo it points into.
    if [[ "$(realpath -m "$dst/$rel")" != "$dstReal"/* ]]; then
      echo "mugen-shell: $dst/$rel links outside $dst, leaving it alone" >&2
      continue
    fi
    if (( first_sync )) && [[ -f "$dst/$rel" && ! -e "$dst/$rel.pre-mugen-shell" ]] \
        && ! same_content "$f" "$dst/$rel"; then
      "${RUN[@]}" cp -p "$dst/$rel" "$dst/$rel.pre-mugen-shell"
      (( ${#RUN[@]} )) || echo "mugen-shell: kept the existing $dst/$rel as $rel.pre-mugen-shell" >&2
    fi
    mode=644
    [[ -x "$f" ]] && mode=755
    "${RUN[@]}" mkdir -p "$(dirname "$dst/$rel")"
    # `install` unlinks first, and a Hyprland reload landing in that window latches an error.
    "${RUN[@]}" install -m "$mode" "$f" "$dst/$rel.new"
    "${RUN[@]}" mv -f "$dst/$rel.new" "$dst/$rel"
  done < <(find "$src" -type f -print0)
}

install_product_tree "$SHARE/hypr" "$CONFIG/hypr" \
  hypridle.conf colors.lua configs/blur.lua \
  configs/user-overrides.lua configs/keybind-overrides.lua
install_product_tree "$SHARE/matugen" "$CONFIG/matugen"
install_dir  "$SHARE/cava"          "$CONFIG/cava"
# cava exits on a missing theme, and matugen only writes this one after the first wallpaper change.
if [[ -f "$SHARE/cava/themes/solarized_dark" ]]; then
  install_file "$SHARE/cava/themes/solarized_dark" "$CONFIG/cava/themes/colors.conf"
fi
install_dir  "$SHARE/kitty"         "$CONFIG/kitty"
install_dir  "$SHARE/fastfetch"     "$CONFIG/fastfetch"
install_file "$SHARE/starship.toml" "$CONFIG/starship.toml"
# matugen writes colors.css into both; nothing reads it without this import.
install_file "$SHARE/gtk/gtk.css"   "$CONFIG/gtk-3.0/gtk.css"
install_file "$SHARE/gtk/gtk.css"   "$CONFIG/gtk-4.0/gtk.css"

rewrite_paths() {
  local script="$1" f real; shift
  for f in "$@"; do
    [[ -f "$f" ]] || continue
    real=$(realpath -m "$f")
    # A link out of $CONFIG belongs to a checkout or dotfiles repo, where this would rewrite a tracked file.
    if [[ "$real" != "$(realpath -m "$CONFIG")"/* ]]; then
      echo "mugen-shell: $f links outside $CONFIG, leaving its paths alone" >&2
      continue
    fi
    # `sed -i` on the link itself would replace it with a copy.
    "${RUN[@]}" sed -i "$script" "$real"
  done
}

# matugen and hypridle expand ~ but not $XDG_CONFIG_HOME.
if [[ "$CONFIG" != "$HOME/.config" ]]; then
  rewrite_paths "s|~/\.config/|$CONFIG/|g; s|\$HOME/\.config/|$CONFIG/|g" \
                "$CONFIG/matugen/config.toml" \
                "$CONFIG/hypr/hypridle.conf"
fi

# matugen expands ~ but not $XDG_CACHE_HOME either, and the bar reads the palette from the latter.
if [[ "$CACHE" != "$HOME/.cache" ]]; then
  rewrite_paths "s|~/\.cache/|$CACHE/|g" "$CONFIG/matugen/config.toml"
fi

# `quickshell -c mugen-shell` resolves the config name through this path only.
if [[ -d "$SHARE/qml" ]]; then
  link="$CONFIG/quickshell/mugen-shell"
  # One that still resolves was aimed at a checkout on purpose; only a missing or dangling one is ours.
  if [[ ! -e "$link" ]]; then
    "${RUN[@]}" mkdir -p "$CONFIG/quickshell"
    "${RUN[@]}" ln -sfn "$SHARE/qml" "$link"
  fi
fi

# Quickshell's FileView only watches a parent directory that exists when it starts, and never retries.
"${RUN[@]}" mkdir -p "$CONFIG/mugen-shell" "$CACHE/mugen-shell/wallp"

# kitty's desktop entry also claims folders, so with nothing chosen `xdg-open <dir>` opened a terminal.
IFS=: read -ra config_dirs <<< "${XDG_CONFIG_DIRS:-/etc/xdg}"
IFS=: read -ra data_dirs <<< "${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

lists_default_for() {
  awk -v key="$1=" '
    { line = $0; gsub(/[ \t\r]/, "", line) }
    index(line, "[") == 1 { in_defaults = index(line, "[DefaultApplications]") == 1; next }
    in_defaults && index(line, key) == 1 && length(line) > length(key) { found = 1; exit }
    END { exit !found }
  ' "$2"
}

# Reads every list xdg-mime reads, spaced the way GLib also accepts, so no choice is ever overridden.
folder_handler_chosen() {
  local desktops dirs=("$CONFIG" "${config_dirs[@]}") dir name list
  IFS=: read -ra desktops <<< "${XDG_CURRENT_DESKTOP:-}"
  for dir in "${data_dirs[@]}"; do dirs+=("$dir/applications"); done
  for dir in "${dirs[@]}"; do
    for name in "${desktops[@],,}" ""; do
      list="$dir/${name:+$name-}mimeapps.list"
      [[ -f "$list" ]] && lists_default_for inode/directory "$list" && return 0
    done
    list="$dir/defaults.list"
    [[ -f "$list" ]] && lists_default_for inode/directory "$list" && return 0
  done
  return 1
}

thunar_installed() {
  local dir
  for dir in "${data_dirs[@]}"; do
    [[ -f "$dir/applications/thunar.desktop" ]] && return 0
  done
  return 1
}

if command -v xdg-mime > /dev/null && thunar_installed && ! folder_handler_chosen; then
  # xdg-mime writes through the link, and a dangling one leaves a stray .new in the working directory.
  if [[ -L "$CONFIG/mimeapps.list" && ! -e "$CONFIG/mimeapps.list" ]]; then
    echo "mugen-shell: $CONFIG/mimeapps.list is a broken link, leaving the folder handler alone" >&2
  else
    # xdg-mime exits 0 even when it could not write, and its mv prompts on a tty.
    "${RUN[@]}" xdg-mime default thunar.desktop inode/directory < /dev/null || true
    if (( ! ${#RUN[@]} )); then
      if folder_handler_chosen; then
        echo "mugen-shell: made Thunar the folder handler, nothing had claimed it" >&2
      else
        echo "mugen-shell: could not make Thunar the folder handler" >&2
      fi
    fi
  fi
fi
